@@ -0,0 +1,28 @@
+package host
+
+import (
+	"github.com/MOVEI144/RunnerLoom/internal/core"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestGuestJobIsIndependentOfCloudFinalAndSerialLogin(t *testing.T) {
+	a := core.Instance{Deadline: time.Now().Add(time.Hour)}
+	for _, diagnostic := range []bool{false, true} {
+		config := string(cloudConfig(a, "TEST_JIT", diagnostic, "172.30.240.1:1234"))
+		for _, want := range []string{
+			"After=cloud-final.service network-online.target", "StandardOutput=journal+console",
+			"StandardError=journal+console", "StandardInput=null", "Restart=no",
+			"[systemctl, start, --no-block, runnerloom-job.service]",
+			"[systemctl, mask, --now, serial-getty@ttyS0.service]",
+		} {
+			if !strings.Contains(config, want) {
+				t.Fatal("missing guest lifecycle requirement", want)
+			}
+		}
+		if strings.Contains(config, ">/dev/ttyS0") {
+			t.Fatal("payload must not inherit a login terminal")
+		}
+	}
+}
